        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen no se cerró, así que no se cambió nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zen não encerrou, então nada foi alterado."
          }
        }
      }
    },
    "Zen has to be closed to back it up. Configgy also backs it up by itself each time you quit Zen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen has to be closed to back it up. Configgy also backs it up by itself each time you quit Zen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要先關閉 Zen 才能備份。每次你結束 Zen，Configgy 也會自動備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップするには Zen を閉じる必要があります。Zen を終了するたびに Configgy が自動でもバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업하려면 Zen을 닫아야 합니다. Zen을 종료할 때마다 Configgy가 자동으로도 백업합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen tiene que estar cerrado para copiarlo. Configgy también lo copia solo cada vez que lo cierras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zen precisa estar fechado para o backup. O Configgy também faz backup sozinho sempre que você o encerra."
          }
        }
      }
    },
    "Zen has to be closed to back it up. It reopens when the backup is done.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen has to be closed to back it up. It reopens when the backup is done."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要先關閉 Zen 才能備份，備份完會重新打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップするには Zen を閉じる必要があります。終わると再び開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업하려면 Zen을 닫아야 합니다. 백업이 끝나면 다시 엽니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen tiene que estar cerrado para copiarlo. Se vuelve a abrir al terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zen precisa estar fechado para o backup. Ele reabre ao terminar."
          }
        }
      }
    },
    "Zen has to be closed while its files are replaced. It reopens when the restore is done.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen has to be closed while its files are replaced. It reopens when the restore is done."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代 Zen 的檔案時要先關閉它，還原完會重新打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを置き換える間は Zen を閉じる必要があります。復元が終わると再び開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 바꾸는 동안 Zen을 닫아야 합니다. 복원이 끝나면 다시 엽니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen tiene que estar cerrado mientras se reemplazan sus archivos. Se vuelve a abrir al terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zen precisa estar fechado enquanto os arquivos são substituídos. Ele reabre ao terminar."
          }
        }
      }
    },
