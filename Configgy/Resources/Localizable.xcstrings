    },
    "A folder your cloud app syncs, so your other Macs see the same backups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder your cloud app syncs, so your other Macs see the same backups."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選一個雲端 App 會同步的資料夾，你的其他 Mac 才看得到同一份備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドアプリが同期するフォルダを選ぶと、ほかのMacからも同じバックアップが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 앱이 동기화하는 폴더를 고르면 다른 Mac에서도 같은 백업을 볼 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta que sincronice tu app de nube, para que tus otros Mac vean las mismas copias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta que seu app de nuvem sincroniza, para que seus outros Macs vejam os mesmos backups."
          }
        }
      }
    },
    "A newer Zen backup is available": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer Zen backup is available"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有比較新的 Zen 備份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい Zen のバックアップがあります"
          }
        },
        "ko": {
          "stringUnit": {
