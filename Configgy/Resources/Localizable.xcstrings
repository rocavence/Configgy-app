    "Choose a folder that syncs to the cloud. Configgy keeps its backups in a Configgy folder inside it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder that syncs to the cloud. Configgy keeps its backups in a Configgy folder inside it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選一個會同步到雲端的資料夾，Configgy 會把備份放在裡面的 Configgy 資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドに同期するフォルダを選んでください。Configgy はその中の Configgy フォルダにバックアップを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드와 동기화되는 폴더를 고르세요. Configgy는 그 안의 Configgy 폴더에 백업을 보관합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta que se sincronice con la nube. Configgy guarda sus copias en una carpeta Configgy dentro de ella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta que sincronize com a nuvem. O Configgy guarda os backups em uma pasta Configgy dentro dela."
          }
        }
      }
    },
    "Choose settings files or folders to back up together.": {
      "localizations": {
        "en": {
