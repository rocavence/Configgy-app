    "%lld older backups contain secret files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld older backups contain secret files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 份舊備份含有祕密檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個の古いバックアップに秘密ファイルがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 백업 %lld개에 비밀 파일이 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
