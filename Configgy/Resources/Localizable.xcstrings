    "Never backed up: logins, passwords, cookies, keys, tokens, .env files and browsing sessions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never backed up: logins, passwords, cookies, keys, tokens, .env files and browsing sessions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律不備份：登入資料、密碼、cookie、金鑰、token、.env 檔與瀏覽紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップしないもの：ログイン情報、パスワード、Cookie、鍵、トークン、.env ファイル、閲覧セッション。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업하지 않는 것: 로그인 정보, 암호, 쿠키, 키, 토큰, .env 파일, 브라우징 세션."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se copian: inicios de sesión, contraseñas, cookies, claves, tokens, archivos .env ni sesiones del navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vão para o backup: logins, senhas, cookies, chaves, tokens, arquivos .env e sessões de navegação."
