    "%@ didn't back up": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't back up"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 備份失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のバックアップに失敗しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 백업 실패"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se pudo copiar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup de %@ falhou"
          }
        }
      }
    },
    "%@ is missing. Check that the cloud app is running, or choose another folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is missing. Check that the cloud app is running, or choose another folder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@。請確認雲端 App 有在執行，或改選其他資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が見つかりません。クラウドアプリが起動しているか確認するか、別のフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 찾을 수 없습니다. 클라우드 앱이 실행 중인지 확인하거나 다른 폴더를 고르세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra %@. Comprueba que la app de nube esté abierta o elige otra carpeta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não foi encontrado. Verifique se o app de nuvem está aberto ou escolha outra pasta."
          }
        }
      }
    },
    "%@ is still open. Quit it first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is still open. Quit it first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 還開著，請先結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がまだ開いています。先に終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 아직 열려 있습니다. 먼저 종료하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue abierto. Ciérralo primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda está aberto. Encerre-o primeiro."
          }
        }
      }
    },
    "%@ isn't backed up": {
      "localizations": {
        "en": {
