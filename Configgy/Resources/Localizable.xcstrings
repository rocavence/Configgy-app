          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を選ばない限り、バックアップはフォルダに残ります。削除したバックアップは元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 선택하지 않으면 백업은 폴더에 남습니다. 삭제한 백업은 복구할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias se quedan en la carpeta salvo que elijas eliminarlas. Las eliminadas no se pueden recuperar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups ficam na pasta, a menos que você escolha apagá-los. Backups apagados não podem ser recuperados."
          }
        }
      }
    },
