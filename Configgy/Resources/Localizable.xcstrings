    "The backup folder isn't available: %@. Check that the cloud app is running, or choose another folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup folder isn't available: %@. Check that the cloud app is running, or choose another folder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用備份資料夾：%@。請確認雲端 App 有在執行，或改選其他資料夾。"
          }
        },
        "ja": {
