    "macOS asks for Full Disk Access before an app can write to Dropbox. Add Configgy in the list that opens, turn it on, then quit and reopen Configgy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for Full Disk Access before an app can write to Dropbox. Add Configgy in the list that opens, turn it on, then quit and reopen Configgy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 要寫入 Dropbox 前，macOS 會要求完整磁碟取用權。請在打開的清單裡加入 Configgy 並打開開關，再結束並重新打開 Configgy。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが Dropbox に書き込むには、macOS のフルディスクアクセスが必要です。開いたリストに Configgy を追加してオンにし、Configgy を終了してから開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 Dropbox에 쓰려면 macOS의 전체 디스크 접근 권한이 필요합니다. 열리는 목록에 Configgy를 추가해 켠 뒤 Configgy를 종료하고 다시 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide Acceso total al disco antes de que una app escriba en Dropbox. Añade Configgy en la lista que se abre, actívalo y luego cierra y vuelve a abrir Configgy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pede Acesso Total ao Disco antes de um app gravar no Dropbox. Adicione o Configgy na lista que abrir, ative-o, depois encerre e reabra o Configgy."
          }
        }
      }
    },
    "macOS is waiting for your OK in System Settings › Login Items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for your OK in System Settings › Login Items."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 在等你到「系統設定 › 登入項目」同意。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が「システム設定 › ログイン項目」で許可を待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 시스템 설정 › 로그인 항목에서 승인을 기다리고 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS espera tu permiso en Ajustes del Sistema › Ítems de inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS aguarda sua permissão em Ajustes do Sistema › Itens de Início."
          }
        }
      }
    },
