    "Logins, keys, tokens, cookies, saved passwords and session history, for every target.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logins, keys, tokens, cookies, saved passwords and session history, for every target."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有項目都不收：登入資料、金鑰、token、cookie、儲存的密碼與瀏覽紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての項目で、ログイン情報、鍵、トークン、Cookie、保存したパスワード、セッション履歴は含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목에서 로그인 정보, 키, 토큰, 쿠키, 저장된 암호, 세션 기록은 넣지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En todos los elementos: inicios de sesión, claves, tokens, cookies, contraseñas guardadas e historial de sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em todos os itens: logins, chaves, tokens, cookies, senhas salvas e histórico de sessão."
          }
        }
      }
    },
