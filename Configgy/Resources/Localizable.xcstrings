    "%lld backups from before 1.0 include logins or keys. Remove those files to keep the rest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld backups from before 1.0 include logins or keys. Remove those files to keep the rest."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 份 1.0 以前的備份含有登入資料或金鑰。移除這些檔案，其他內容都會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0 より前のバックアップ %lld 個にログイン情報や鍵が含まれています。それらを削除すれば残りは保てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0 이전 백업 %lld개에 로그인 정보나 키가 있습니다. 그 파일만 지우면 나머지는 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld copias anteriores a la 1.0 incluyen inicios de sesión o claves. Quita esos archivos y conserva el resto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld backups anteriores à 1.0 incluem logins ou chaves. Remova esses arquivos e mantenha o resto."
          }
        }
      }
    },
    "%lld backups you can restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld backups you can restore"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 份可以還原"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元できるバックアップ %lld 個"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 수 있는 백업 %lld개"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld copias para restaurar"
          }
        },
        "pt-BR": {
