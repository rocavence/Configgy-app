    "Chosen workspaces join Zen's current ones (or replace ones with the same name); everything else stays.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chosen workspaces join Zen's current ones (or replace ones with the same name); everything else stays."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選的工作區會加進 Zen 目前的工作區（同一個就取代），其他都不動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだワークスペースは Zen の現在のものに加わります（同じものは置き換え）。ほかはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 작업 공간은 Zen의 현재 작업 공간에 추가됩니다(같은 것은 대체). 나머지는 그대로입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios elegidos se suman a los actuales de Zen (o reemplazan el mismo); lo demás no cambia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os espaços escolhidos se juntam aos atuais do Zen (ou substituem o mesmo); o resto fica como está."
          }
        }
      }
