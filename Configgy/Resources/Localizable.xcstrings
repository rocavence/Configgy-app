    "Each time you quit Zen, its settings and workspaces are backed up if they changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time you quit Zen, its settings and workspaces are backed up if they changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次結束 Zen，如果設定或工作區有變動就自動備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen を終了するたびに、設定やワークスペースが変わっていればバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen을 종료할 때마다 설정과 작업 공간이 바뀌었으면 백업합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que cierras Zen, sus ajustes y espacios se copian si cambiaron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre que você encerra o Zen, os ajustes e espaços são salvos se mudaram."
          }
        }
      }
    },
