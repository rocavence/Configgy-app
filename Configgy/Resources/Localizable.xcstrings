        }
      }
    },
    "The claude command wasn't found, so plugins weren't reinstalled. Install Claude Code, then run /plugin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The claude command wasn't found, so plugins weren't reinstalled. Install Claude Code, then run /plugin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 claude 指令，所以沒有重新安裝外掛。請先安裝 Claude Code，再執行 /plugin。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "claude コマンドが見つからないため、プラグインを再インストールしませんでした。Claude Code をインストールしてから /plugin を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "claude 명령을 찾지 못해 플러그인을 다시 설치하지 않았습니다. Claude Code를 설치한 뒤 /plugin을 실행하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el comando claude, así que no se reinstalaron los plugins. Instala Claude Code y ejecuta /plugin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando claude não foi encontrado, então os plugins não foram reinstalados. Instale o Claude Code e rode /plugin."
          }
        }
      }
    },
