    "%lld files were skipped: secrets, or outside this target.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files were skipped: secrets, or outside this target."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略過了 %lld 個檔案：祕密檔，或不在這個項目的範圍內。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のファイルをスキップしました：秘密ファイル、またはこの項目の範囲外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개를 건너뛰었습니다: 비밀 파일이거나 이 항목의 범위 밖입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron %lld archivos: secretos o fuera de este elemento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld arquivos foram ignorados: secretos ou fora deste item."
          }
        }
      }
    },
    "%lld files will be replaced and %lld added. Configgy saves the current versions first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files will be replaced and %lld added. Configgy saves the current versions first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會取代 %1$lld 個檔案、新增 %2$lld 個。Configgy 會先保存目前的版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個のファイルを置き換え、%2$lld 個を追加します。Configgy は先に現在の版を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %1$lld개를 바꾸고 %2$lld개를 추가합니다. Configgy가 현재 버전을 먼저 저장합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazarán %1$lld archivos y se añadirán %2$lld. Configgy guarda primero las versiones actuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld arquivos serão substituídos e %2$lld adicionados. O Configgy salva as versões atuais primeiro."
          }
        }
      }
    },
